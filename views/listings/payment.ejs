<% layout("/layouts/boilerplate") %>

<!-- ===== BOOKING CONFIRMATION & PAYMENT MOCKUP ===== -->
<div class="container pt-3 pb-5 reveal">
    <a href="/listings/<%= listing._id %>" class="btn btn-glass btn-sm mb-4 d-inline-flex align-items-center">
        <i class="fa-solid fa-chevron-left me-1"></i> Back to Listing
    </a>

    <h2 class="mb-4 text-primary-glow">Confirm and Pay</h2>

    <div class="row g-5 payment-layout-row">
        
        <!-- ===== LEFT COLUMN: PAYMENT FORM ===== -->
        <div class="col-lg-7 payment-left-col">

            <!-- Trip summary (Selected from query params) -->
            <div class="show-info-card mb-4 payment-trip-card">
                <h4><i class="fa-solid fa-calendar-check" style="color: #00D8FF;"></i> Trip Details</h4>
                <div class="row mt-3">
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted d-block" style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700;">Dates</span>
                        <span id="payment-dates-val" class="fw-semibold">Loading dates...</span>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <span class="text-muted d-block" style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700;">Guests</span>
                        <span id="payment-guests-val" class="fw-semibold">1 guest</span>
                    </div>
                </div>
            </div>

            <!-- Payment Card -->
            <div class="show-info-card mb-4 payment-method-card">
                <h4><i class="fa-solid fa-shield-halved" style="color: #00D8FF;"></i> Payment</h4>
                
                <div class="my-4 p-3 rounded" style="background: rgba(0, 216, 255, 0.05); border: 1px solid rgba(0, 216, 255, 0.15); display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-lock text-primary-glow" style="font-size: 1.1rem;"></i>
                    <span class="fw-semibold text-primary-glow" style="font-size: 0.95rem;">Secure Payment powered by Razorpay</span>
                </div>

                <div class="mb-4">
                    <span class="text-muted d-block mb-3" style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Accepted payment methods:</span>
                    <div class="row g-2 payment-methods-row">
                        <div class="col-6 col-sm-4">
                            <div class="p-2 rounded border border-secondary text-center" style="background: rgba(255,255,255,0.02); font-size: 0.85rem;">
                                <i class="fa-solid fa-check text-success me-1"></i> UPI
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="p-2 rounded border border-secondary text-center" style="background: rgba(255,255,255,0.02); font-size: 0.85rem;">
                                <i class="fa-solid fa-check text-success me-1"></i> Credit & Debit Cards
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="p-2 rounded border border-secondary text-center" style="background: rgba(255,255,255,0.02); font-size: 0.85rem;">
                                <i class="fa-solid fa-check text-success me-1"></i> Net Banking
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="p-2 rounded border border-secondary text-center" style="background: rgba(255,255,255,0.02); font-size: 0.85rem;">
                                <i class="fa-solid fa-check text-success me-1"></i> Wallets
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="p-2 rounded border border-secondary text-center" style="background: rgba(255,255,255,0.02); font-size: 0.85rem;">
                                <i class="fa-solid fa-check text-success me-1"></i> EMI
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="p-2 rounded border border-secondary text-center" style="background: rgba(255,255,255,0.02); font-size: 0.85rem;">
                                <i class="fa-solid fa-check text-success me-1"></i> Pay Later
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-3 rounded mb-4" style="background: rgba(255,255,255,0.01); border: 1px dashed rgba(255,255,255,0.08);">
                    <p class="mb-0 text-muted" style="font-size: 0.82rem; line-height: 1.5;">
                        Your payment details will be collected securely by Razorpay. Havenly never stores your card or UPI information.
                    </p>
                </div>

                <form id="payment-form" class="m-0">
                    <button
                        id="pay-button"
                        class="btn btn-reserve-glow w-100 py-3 fw-bold"
                        type="submit"
                    >
                        Pay Securely
                    </button>
                </form>
            </div>
        </div>

        <!-- ===== RIGHT COLUMN: BILL BREAKDOWN ===== -->
        <div class="col-lg-5 payment-price-col">
            <div class="show-info-card sticky-top" style="top: 5.8rem;">
                
                <!-- Listing summary card -->
                <div class="d-flex gap-3 align-items-center mb-4 payment-summary-item">
                    <img src="<%= listing.image.url %>" alt="<%= listing.title %>" style="width: 100px; height: 75px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid rgba(0, 216, 255, 0.15); flex-shrink: 0;">
                    <div class="payment-summary-info">
                        <h5 class="mb-1 payment-summary-title"><%= listing.title %></h5>
                        <p class="text-muted mb-0" style="font-size: 0.82rem;"><i class="fa-solid fa-location-dot me-1"></i> <%= listing.location %>, <%= listing.country %></p>
                        <span style="font-size: 0.8rem; color: var(--accent);"><i class="fa-solid fa-star me-1"></i> 4.8</span>
                    </div>
                </div>

                <hr style="opacity: 0.1;">

                <!-- Price Details -->
                <h4 class="mb-3">Price Details</h4>
                <div class="d-flex justify-content-between mb-2">
                    <span id="rate-breakdown-text" class="text-muted">&#8377; <%= listing.price.toLocaleString("en-IN") %> x 0 nights</span>
                    <span id="base-price-val" class="fw-semibold">&#8377; 0</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">GST (18%)</span>
                    <span id="gst-val" class="fw-semibold">&#8377; 0</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Service Fee</span>
                    <span class="fw-semibold text-success">Free</span>
                </div>

                <hr style="opacity: 0.1;">

                <!-- Total Amount -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fw-bold" style="font-size: 1.1rem;">Total (INR)</span>
                    <span id="total-amount-val" class="fw-bold text-primary-glow" style="font-size: 1.3rem;">&#8377; 0</span>
                </div>

                <div class="p-3 rounded" style="background: rgba(0, 216, 255, 0.05); border: 1px solid rgba(0, 216, 255, 0.15);">
                    <p class="mb-0 text-muted" style="font-size: 0.78rem; line-height: 1.45;">
                        <i class="fa-solid fa-circle-info text-primary-glow me-1"></i>
                        <strong>Havenly Guarantee:</strong> Your funds will be securely held and only transferred to the host after your check-in.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<!-- ===== PAGE LOGIC AND FORM SUBMISSION ===== -->
<script>
(function initPaymentPage() {
    const urlParams = new URLSearchParams(window.location.search);
    const checkInStr = urlParams.get('checkIn');
    const checkOutStr = urlParams.get('checkOut');
    const guestsStr = urlParams.get('guests') || '1 guest';

    const datesVal = document.getElementById('payment-dates-val');
    const guestsVal = document.getElementById('payment-guests-val');

    const rateBreakdown = document.getElementById('rate-breakdown-text');
    const basePriceVal = document.getElementById('base-price-val');
    const gstVal = document.getElementById('gst-val');
    const totalVal = document.getElementById('total-amount-val');

    const listingPrice = <%= listing.price %>;

    if (checkInStr && checkOutStr) {
        if (datesVal) datesVal.textContent = `${checkInStr} – ${checkOutStr}`;
        if (guestsVal) guestsVal.textContent = guestsStr;

        // Parse dates to calculate nights accurately (including cross-month stays)
        const d1 = new Date(checkInStr);
        const d2 = new Date(checkOutStr);
        const msPerDay = 1000 * 60 * 60 * 24;
        const nights = (!isNaN(d1) && !isNaN(d2)) ? Math.ceil((d2 - d1) / msPerDay) : 0;

        if (nights > 0) {
            const baseTotal = listingPrice * nights;
            const gst = baseTotal * 0.18;
            const grandTotal = baseTotal + gst;

            if (rateBreakdown) rateBreakdown.textContent = `₹ ${listingPrice.toLocaleString("en-IN")} x ${nights} night${nights > 1 ? 's' : ''}`;
            if (basePriceVal) basePriceVal.innerHTML = `&#8377; ${baseTotal.toLocaleString("en-IN")}`;
            if (gstVal) gstVal.innerHTML = `&#8377; ${gst.toLocaleString("en-IN")}`;
            if (totalVal) totalVal.innerHTML = `&#8377; ${grandTotal.toLocaleString("en-IN")}`;
        }
    } else {
        // Default to 1 night if no query params passed
        if (datesVal) datesVal.textContent = "Dates not selected";
        const baseTotal = listingPrice;
        const gst = baseTotal * 0.18;
        const grandTotal = baseTotal + gst;

        if (rateBreakdown) rateBreakdown.textContent = `₹ ${listingPrice.toLocaleString("en-IN")} x 1 night`;
        if (basePriceVal) basePriceVal.innerHTML = `&#8377; ${baseTotal.toLocaleString("en-IN")}`;
        if (gstVal) gstVal.innerHTML = `&#8377; ${gst.toLocaleString("en-IN")}`;
        if (totalVal) totalVal.innerHTML = `&#8377; ${grandTotal.toLocaleString("en-IN")}`;
    }

    // Form Submission Mockup
    const form = document.getElementById("payment-form");
    const payButton = document.getElementById("pay-button");

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            let paymentFailed = false;
            if (payButton.disabled) return;

            payButton.disabled = true;
            payButton.innerHTML = `
                <i class="fa-solid fa-spinner fa-spin me-2"></i>
                Processing...
            `;

            const bookingData = {
                listingId: "<%= listing._id %>",
                checkIn: checkInStr,
                checkOut: checkOutStr,
                guests: parseInt(guestsStr),
            };

            try {
                const response = await fetch("/bookings/create-order", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(bookingData),
                });

                const data = await response.json();
            
                if (!response.ok || !data.success) {
                    resetPayButton();

                    showErrorNotification(
                        data.message || "Unable to create payment order."
                    );

                    return;
                }

                const options = {
                    key: "<%= razorpayKeyId %>",
                    amount: data.order.amount,
                    currency: data.order.currency,
                    name: "Havenly",
                    description: "Booking Payment",
                    order_id: data.order.id,

                    prefill: {
                        name: "<%= currUser.username %>",
                        email: "<%= currUser.email %>",
                    },

                    handler: async function (response) {
                        console.log("Payment Success!");
                        console.log(response);

                        try {
                            const verifyResponse = await fetch("/bookings/verify-payment", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                },
                                body: JSON.stringify({
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_signature: response.razorpay_signature,

                                    listingId: bookingData.listingId,
                                    checkIn: bookingData.checkIn,
                                    checkOut: bookingData.checkOut,
                                    guests: bookingData.guests,
                                }),
                            });

                            const result = await verifyResponse.json();

                            if (!verifyResponse.ok || !result.success) {
                                resetPayButton();

                                showErrorNotification(
                                    result.message || "Payment verification failed."
                                );

                                return;
                            }

                            showSuccessNotification("Booking Confirmed!");

                            setTimeout(() => {
                                window.location.href = "/bookings/my-bookings";
                            }, 1500);

                        } catch (err) {
                            console.error("Payment Verification Error:", err);

                            resetPayButton();

                            showErrorNotification(
                                "Payment verification could not be completed. Please check My Bookings before trying again."
                            );
                        }
                    },

                    theme: {
                        color: "#00D8FF",
                    },

                    modal: {
                        ondismiss: function () {
                            resetPayButton();

                            if (!paymentFailed) {
                                showErrorNotification(
                                    "Payment cancelled. You can try again."
                                );
                            }
                        },
                    },
                };

                const rzp = new Razorpay(options);

                rzp.on("payment.failed", function (response) {
                    paymentFailed = true;
                    console.error("Razorpay Payment Failed:", response.error);

                    resetPayButton();

                    const errorMessage =
                        response.error?.description ||
                        response.error?.reason ||
                        "Payment failed. Please try again.";

                    showErrorNotification(errorMessage);
                });

                rzp.open();

            } catch (error) {
                console.error("Create Order Error:", error);

                resetPayButton();

                showErrorNotification(
                    "Unable to start payment. Please check your connection and try again."
                );
            }
        });
    }

    function resetPayButton() {
        if (!payButton) return;

        payButton.disabled = false;
        payButton.innerHTML = "Pay Securely";
    }

    function showSuccessNotification(message) {
        let container = document.getElementById('notification-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'notification-container';
            document.body.appendChild(container);
        }

        const notification = document.createElement('div');
        notification.className = 'toast-notification';
        notification.innerHTML = `
            <div class="toast-content">
                <i class="fa-solid fa-circle-check toast-icon toast-icon-success"></i>
                <span class="toast-message">${message}</span>
            </div>
        `;
        container.appendChild(notification);

        setTimeout(() => {
            notification.classList.add('show');
        }, 10);

        setTimeout(() => {
            notification.classList.remove('show');
            notification.classList.add('hide');
            setTimeout(() => {
                notification.remove();
            }, 400);
        }, 3000);
    }

    function showErrorNotification(message) {
        let container = document.getElementById('notification-container');

        if (!container) {
            container = document.createElement('div');
            container.id = 'notification-container';
            document.body.appendChild(container);
        }

        const notification = document.createElement('div');
        notification.className = 'toast-notification error-toast';
        
        notification.innerHTML = `
            <div class="toast-content">
                <i class="fa-solid fa-circle-xmark toast-icon"></i>
                <span class="toast-message">${message}</span>
            </div>
        `;

        container.appendChild(notification);

        setTimeout(() => {
            notification.classList.add('show');
        }, 10);

        setTimeout(() => {
            notification.classList.remove('show');
            notification.classList.add('hide');

            setTimeout(() => {
                notification.remove();
            }, 400);
        }, 4000);
    }

})();
</script>
