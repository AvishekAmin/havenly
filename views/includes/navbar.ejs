<% 
const currentUser = (typeof currUser !== 'undefined' && currUser) ? currUser : ((typeof locals !== 'undefined' && locals.currUser) ? locals.currUser : null);
%>
<nav class="navbar navbar-expand-lg glass-navbar">
    <div class="container-fluid d-flex align-items-center justify-content-between">

        <!-- Logo (Left) -->
        <a class="navbar-brand logo" href="/listings">
            <i class="fa-solid fa-house-chimney logo-icon" style="color: var(--accent); filter: drop-shadow(0 0 6px rgba(0, 216, 255, 0.45));"></i><span class="logo-text">Havenly</span>
        </a>

        <!-- Desktop Nav Links (Hidden on Mobile) -->
        <div class="desktop-nav-links d-none d-lg-flex align-items-center me-auto ms-3">
            <a class="nav-link" href="/listings">Explore</a>
            <a class="nav-link" href="/listings/new">Add Your Home</a>
        </div>

        <!-- Search Form (Center on Mobile, Flex on Desktop) -->
        <form class="d-flex align-items-center nav-search-form me-lg-3" role="search">
            <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations..." aria-label="Search" id="nav-search-input">
            <button class="btn search-btn" type="submit">
                <i class="fa-solid fa-magnifying-glass"></i><span class="search-btn-text"> Search</span>
            </button>
        </form>

        <!-- Right Side: Auth / Hamburger / Avatar Dropdown -->
        <div class="d-flex align-items-center nav-right-section">
            <% if (!currentUser) { %>
                <!-- Desktop Auth Buttons (Hidden on Mobile) -->
                <div class="d-none d-lg-flex align-items-center gap-2">
                    <a href="/signup" class="nav-auth-btn signup">Sign Up</a>
                    <a href="/login" class="nav-auth-btn login">Log In</a>
                </div>

                <!-- Mobile Hamburger Dropdown (Shown only on Mobile when not logged in) -->
                <div class="dropdown d-lg-none">
                    <button class="btn mobile-hamburger-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Toggle navigation">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end glass-dropdown">
                        <li>
                            <a class="dropdown-item" href="/signup">
                                <i class="fa-solid fa-user-plus me-2"></i>Sign Up
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/login">
                                <i class="fa-solid fa-right-to-bracket me-2"></i>Log In
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="/listings">
                                <i class="fa-solid fa-compass me-2"></i>Explore
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/listings/new">
                                <i class="fa-solid fa-plus me-2"></i>Add Your Home
                            </a>
                        </li>
                    </ul>
                </div>
            <% } else { %>
                <!-- Logged In User Avatar Dropdown (Replaces Hamburger on Mobile & standard on Desktop) -->
                <div class="dropdown">
                    <button class="btn user-avatar-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
                        <span class="user-avatar-circle">
                            <%= currentUser.username.charAt(0).toUpperCase() %>
                        </span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end glass-dropdown">
                        <li>
                            <span class="dropdown-item-text fw-semibold">
                                <i class="fa-solid fa-user me-2"></i>
                                <%= currentUser.username %>
                            </span>
                        </li>

                        <!-- Mobile-only links in logged-in dropdown -->
                        <li class="d-lg-none"><hr class="dropdown-divider"></li>
                        <li class="d-lg-none">
                            <a class="dropdown-item" href="/listings">
                                <i class="fa-solid fa-compass me-2"></i>Explore
                            </a>
                        </li>
                        <li class="d-lg-none">
                            <a class="dropdown-item" href="/listings/new">
                                <i class="fa-solid fa-plus me-2"></i>Add Your Home
                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <a class="dropdown-item" href="/bookings/my-bookings">
                                <i class="fa-solid fa-suitcase me-2"></i>My Bookings
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item" href="/host/dashboard">
                                <i class="fa-solid fa-chart-line me-2"></i>Host Dashboard
                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <a class="dropdown-item" href="/logout">
                                <i class="fa-solid fa-right-from-bracket me-2"></i>Log Out
                            </a>
                        </li>
                    </ul>
                </div>
            <% } %>
        </div>

    </div>
</nav>