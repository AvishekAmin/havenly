# ================================================================
# HAVENLY — Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' to version control.
# ================================================================

# Application
PORT=8080
NODE_ENV=development
APP_BASE_URL=https://havenly-avishek.onrender.com
SECRET=your_super_secret_session_key_here

# MongoDB Connection
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/havenly?retryWrites=true&w=majority

# Razorpay Payment Gateway (Test Mode / Production Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Mapbox Geocoding Service
MAP_TOKEN=pk.eyJ1Ixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary Storage
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Email Transport (Nodemailer - Optional in development; Ethereal test account used if omitted)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM="Havenly" <your_email@gmail.com>
